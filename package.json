{
  "name": "distributed-wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/main.ts",
    "typecheck": "bun install && tsc --noEmit -p tsconfig.json",
    "lint": "biome lint src test migrations scripts/sqs-setup.ts scripts/migrate.ts scripts/verify-schema.ts scripts/scan-forbidden.ts",
    "sqs:setup": "bun install && bun run scripts/sqs-setup.ts",
    "migration:up": "bun install && bun run scripts/migrate.ts up",
    "migration:down": "bun install && bun run scripts/migrate.ts down",
    "verify:schema": "bun install && bun run scripts/verify-schema.ts",
    "test:unit": "bun test test/unit",
    "test:acceptance": "bun install && bun test test/acceptance",
    "test:integration": "bun install && bun test test/integration",
    "test:concurrency": "bun install && bun test test/concurrency",
    "test:all": "bun install && bun test"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.700.0",
    "@mikro-orm/core": "^6.4.0",
    "@mikro-orm/migrations": "^6.4.0",
    "@mikro-orm/postgresql": "^6.4.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.1.0",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.11.0",
    "pg": "^8.13.0",
    "typescript": "^5.6.0"
  }
}
