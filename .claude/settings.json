{
  "permissions": {
    "allow": [
      "Bash(bun add:*)",
      "Bash(bun install:*)",
      "Bash(bun run:*)",
      "Bash(bun test:*)",
      "Bash(bun:*)",
      "Bash(bunx tsc:*)",
      "Bash(bunx:*)",
      "Bash(cat:*)",
      "Bash(curl -fs http://localhost:*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(docker compose:*)",
      "Bash(docker logs:*)",
      "Bash(docker ps:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git restore:*)",
      "Bash(git show:*)",
      "Bash(git stash:*)",
      "Bash(git status:*)",
      "Bash(git switch:*)",
      "Bash(git worktree:*)",
      "Bash(head:*)",
      "Bash(kill:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(node:*)",
      "Bash(npx:*)",
      "Bash(pkill -f bun:*)",
      "Bash(psql:*)",
      "Bash(tail:*)",
      "Bash(timeout:*)",
      "Bash(wc:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.ts",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-gate.ts",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
